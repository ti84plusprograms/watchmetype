# Do NOT ignore Markdown: docs in this repo are tracked (README, CHECKPOINT
# files, etc.). The upstream *.md ignore silently dropped new docs, so it
# was removed. If a generated .md file ever needs ignoring, list it by name.

# AI-generated / Claude Code context
.claude/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
Thumbs.db
ehthumbs.db

# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.moved-aside
*.xccheckout
*.xcscmblueprint

# SwiftPM / package managers
.build/
.swiftpm/xcode/xcuserdata

# Editor cruft
*~
*.swp
*.swo
*.orig

# Secrets / signing (never commit the Sparkle private key)
.sparkle/
sparkle_ed25519_private_key
*.pem
*.p12
